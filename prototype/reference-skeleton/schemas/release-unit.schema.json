{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://client-platform-labs.example/rn/release-unit.schema.json",
  "title": "THROWAWAY ReleaseUnit",
  "type": "object",
  "required": ["releaseId", "train", "artifactLines", "state"],
  "properties": {
    "releaseId": { "type": "string" },
    "humanLabel": {
      "type": "string",
      "description": "e.g. Android 8.3.1 / A41"
    },
    "train": {
      "enum": ["ios-host", "android-host", "harmony-host", "js", "experiment"]
    },
    "artifactLines": {
      "type": "array",
      "items": { "type": "string" }
    },
    "compatibilityProfileId": { "type": "string" },
    "state": {
      "enum": [
        "draft",
        "validated",
        "gray",
        "paused",
        "full",
        "rolled_back",
        "blocked_incompatible"
      ]
    },
    "releaseGate": {
      "enum": ["needs-native", "js-standard", "js-gated"]
    }
  },
  "additionalProperties": false
}
