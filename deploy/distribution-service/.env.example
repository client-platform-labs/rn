# ── Auth ────────────────────────────────────────────────────────────────
# Single-tenant (default):
RN_CP_TOKEN=change-me-to-a-long-random-secret
# Multi-tenant thin mode (prefer over single token when set):
# RN_CP_TENANTS={"acme":"tok-acme","beta":"tok-beta"}
# Clients must send: Authorization: Bearer <tok>  +  X-RN-Tenant: <id>
RN_CP_ROLE=admin

# ── Sign / seal (priority: PEM → HMAC → digest-stub) ───────────────────
# RN_DELIVERY_SIGN_KEY=hmac-secret
# RN_DELIVERY_SIGN_KEY_PEM="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----"
# RN_DELIVERY_SIGN_KEY_FILE=/run/secrets/delivery-sign.pem

# sqlite (default) or file
RN_CP_REGISTRY=sqlite

# Set 1 for API-only (no Reference Console at /)
RN_CP_DISABLE_CONSOLE=0

# Lab/local: shorten rollout soak (ms). Default ladder uses 60000 per step.
# RN_CP_MIN_SOAK_MS=5000

# Host port mapping
DISTRIBUTION_PORT=4040

# ── Storage evolution ──────────────────────────────────────────────────
# Postgres is NOT wired (ADR-013). RN_CP_DATABASE_URL is a deferred RDS/HA seam
# (G9); setting it changes nothing on the storage path today. Production storage
# is SQLite (RN_CP_REGISTRY=sqlite) + atomic file writes.
# RN_CP_DATABASE_URL=

# ── Data Service (read-only Python backend, standalone repo ~/code/data-service)
DATA_SERVICE_CONTEXT=../data-service
DATA_SERVICE_PORT=8001
# Optional X-API-Key; when empty reads are open (dev). Set in prod.
DATA_SERVICE_API_KEY=
# Bind-mounts for the SQLite DBs data-service reads.
STOCK_SCREENER_DATA=~/code/stock-screener/data
DASHBOARD_DATA=~/code/dashboard/data
