import React, { useEffect, useState } from "react";
import { NativeModules } from "react-native";
import {
  SafeAreaProvider,
  initialWindowMetrics,
} from "react-native-safe-area-context";
import {
  createOtaClient,
  pullOtaUpdate,
  shouldRollbackOnCrashLoop,
  verifyRevocationSealAny,
  type OtaSidecar,
  type OtaNativeAdapter,
} from "@client-platform/shell-core";
import { FailedUI } from "./FailedUI";
import {
  resolveBaselineSurface,
  resolveModuleSurface,
} from "./ModuleRegistry";
import { DEFAULT_MODULE_ID } from "./ota/slotPaths";
import { cpBaseUrl as declaredCpBaseUrl } from "./generated-runtime";

/**
 * Industrial shell (ADR-021): resolves the active business module by id and runs
 * the device OTA flow via @client-platform/shell-core (copy→depend by
 * construction — no local OTA client copies). The native adapter is injected
 * once; `fetchOtaManifest` targets the control plane (ship serve).
 */
function getNativeAdapter(): OtaNativeAdapter {
  return NativeModules.Ota as OtaNativeAdapter;
}

function cpBaseUrl(): string | null {
  const g = globalThis as Record<string, unknown>;
  const override =
    typeof g["__CP_BASE_URL__"] === "string"
      ? (g["__CP_BASE_URL__"] as string)
      : null;
  if (override) return override;
  // SEAM-2 (F23): declared config from .rn/runtime.jsonc (generated-runtime.ts).
  return typeof declaredCpBaseUrl === "string" && declaredCpBaseUrl.length > 0
    ? declaredCpBaseUrl
    : null;
}

export function ShellHost({
  moduleId = DEFAULT_MODULE_ID,
}: {
  moduleId?: string;
}) {
  const [forceBaseline, setForceBaseline] = useState(false);
  const [bootReady, setBootReady] = useState(__DEV__);

  useEffect(() => {
    if (__DEV__) return; // dev: baseline only, no OTA
    let cancelled = false;
    (async () => {
      const native = getNativeAdapter();
      // ADR-017 — pull baked pubkeys from native before verifying any OTA payload.
      // The Kotlin @ReactMethod is async, but verifySidecar reads the adapter's
      // synchronous getOtaPublicKeys() — patch it with the awaited cache (same
      // contract as templates/greenfield-ota/ReleaseOtaBoot). Empty → fail-closed.
      try {
        const keys = await native.getOtaPublicKeys?.();
        const keyArr =
          keys == null
            ? []
            : Array.from(keys as ArrayLike<string>).filter(
                (k): k is string => typeof k === "string" && k.length === 64,
              );
        native.getOtaPublicKeys = () => keyArr;
      } catch {
        /* stay empty → fail-closed */
      }
      const base = cpBaseUrl();
      if (!base) {
        console.warn(
          "[OTA] control-plane base URL not configured — set cpBaseUrl in .rn/runtime.jsonc (SEAM-2) or __CP_BASE_URL__ at runtime; booting baseline",
        );
        if (!cancelled) setBootReady(true);
        return;
      }
      const client = createOtaClient(native, { defaultModuleId: moduleId });
      // G1/ADR-014: crash-loop guard — consecutive failed boots roll back to
      // the embedded baseline before any OTA pull (same contract as
      // templates/greenfield-ota/ReleaseOtaBoot).
      const failCount = (await native.recordStartupFailure?.(moduleId)) ?? 0;
      if (shouldRollbackOnCrashLoop(failCount)) {
        try {
          await client.rollbackToEmbeddedBaseline(moduleId);
        } catch {
          /* baseline fallback is best-effort */
        }
        if (!cancelled) setBootReady(true);
        return;
      }
      const result = await pullOtaUpdate(client, native, moduleId, {
        lane: "production",
        // ADR-024 (D3/G3): fetch + VERIFY the signed revocation list (CRL)
        // before verifying an update — a revoked signing key is rejected even
        // when the seal is valid, and an unsigned/tampered CRL fails closed.
        fetchRevocations: async () => {
          const res = await fetch(`${base}/v1/crl`);
          if (!res.ok) throw new Error(`CRL HTTP ${res.status}`);
          const body = (await res.json()) as {
            revoked?: string[];
            payload?: string;
            seal?: string | null;
          };
          if (!body || typeof body.seal !== "string" || typeof body.payload !== "string") {
            throw new Error("CRL unsigned");
          }
          if (
            !verifyRevocationSealAny(
              body.seal,
              body.payload,
              Array.from(native.getOtaPublicKeys() ?? []),
            )
          ) {
            throw new Error("CRL seal invalid");
          }
          return Array.isArray(body.revoked) ? body.revoked : [];
        },
        fetchManifest: async (mid, lane) => {
          const res = await fetch(`${base}/v1/js-updates/check?module=${mid}&lane=${lane}`);
          if (!res.ok) return null;
          const body = (await res.json()) as OtaSidecar;
          return body;
        },
      });
      // G1/ADR-014: ANY completed boot (installed / already_installed /
      // no_update / failed) means the JS survived to this point — the previous
      // launch did not crash, so the crash-loop counter resets. Only a boot
      // that dies mid-flight (before this reset) keeps the counter rising.
      await native.resetStartupFailures?.(moduleId);
      if (result.status === "installed") return;
      if (!cancelled) setBootReady(true);
    })().catch(() => {
      if (!cancelled) setBootReady(true);
    });
    return () => {
      cancelled = true;
    };
  }, [moduleId]);

  if (!bootReady) return null;

  const surface = forceBaseline
    ? resolveBaselineSurface(moduleId)
    : resolveModuleSurface(moduleId);

  return (
    <SafeAreaProvider initialMetrics={initialWindowMetrics}>
      {surface.mode === "failed" || !surface.App ? (
        <FailedUI
          reason={surface.reason ?? `module=${surface.moduleId} unknown`}
          onUseBaseline={() => setForceBaseline(true)}
        />
      ) : (
        <surface.App />
      )}
    </SafeAreaProvider>
  );
}
