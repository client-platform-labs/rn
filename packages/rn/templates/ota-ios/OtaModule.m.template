RCT_EXTERN_METHOD(getInstalledUpdateId:(NSString *)moduleId
                  resolver:(RCTPromiseResolveBlock)resolve
                  rejecter:(RCTPromiseRejectBlock)reject)

RCT_EXTERN_METHOD(setInstalledUpdateId:(NSString *)moduleId
